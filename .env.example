# Keep actual secrets in .env (ignored by Git). Never use VITE_ for secret keys.
AI_API_KEY=replace-with-your-provider-key
AI_BASE_URL=https://api.xkiro.com/v1
AI_MODEL=qwen/qwen3.8-max:free

# Required only when building the Android app: URL of the deployed Noor Habit server.
VITE_API_BASE=https://your-noor-habit-server.example
